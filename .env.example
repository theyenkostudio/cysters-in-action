# Copy to .env.local and fill in. Nothing here is required to run `npm run dev`
# with an empty/placeholder Sanity project — the site renders, Studio will just
# have nothing to connect to until these are set.

# --- Sanity (Phase 0) ---------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=development
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Server-only: drafts, Presentation tool, write-token form submissions. Never NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
# Shared secret the Sanity webhook sends to /api/revalidate.
SANITY_REVALIDATE_SECRET=
# Vercel sets this automatically for Cron-triggered requests; set it yourself
# to test /api/cron/* locally (Authorization: Bearer <value>).
CRON_SECRET=

# --- Site ----------------------------------------------------------------
# Canonical origin for metadata, sitemap.xml, robots.txt and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Theme overrides (Section 4) — optional, build-time only -----------
NEXT_PUBLIC_THEME_TEAL=
NEXT_PUBLIC_THEME_PLUM=
NEXT_PUBLIC_THEME_LAGOON=
NEXT_PUBLIC_THEME_ORCHID=
NEXT_PUBLIC_THEME_BLUSH=
NEXT_PUBLIC_THEME_LILAC=
NEXT_PUBLIC_THEME_CANVAS=
NEXT_PUBLIC_FONT_DISPLAY=
NEXT_PUBLIC_FONT_BODY=

# --- Forms (Phase 3+) ----------------------------------------------------
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Email provider adapter (Section 7) ---------------------------------
EMAIL_PROVIDER=null
BREVO_API_KEY=
BREVO_LIST_ID=
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_LIST_ID=
RESEND_API_KEY=

# --- Analytics ------------------------------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
