# Copy to .env.local for local work, or set these in the hosting dashboard.

# The real public address of the site, with no trailing slash. Used for canonical links,
# the sitemap and social sharing cards.
NEXT_PUBLIC_SITE_URL=https://example.org

# Set to "true" only when the site is ready for search engines.
# Anything else (or unset) keeps the site hidden: robots.txt disallows everything and
# every page is marked "noindex".
SEO_INDEXABLE=false
